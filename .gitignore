# Python
__pycache__/
*.py[cod]
.pytest_cache/

# Generated registry artifacts.
#
# Only registry/sources.json is source: it is hand-written and pins every
# upstream source by tag and sha256. Everything else under registry/ is build
# output produced by `python build_registry.py`, and is deliberately not
# committed:
#
#   *.entries.jsonl.gz  -- gzip, so not reviewable in a diff (1.6 MB and
#                          rewritten on every build)
#   *.manifest.json     -- records hashes and counts *observed* during a build;
#                          the hashes that are actually enforced live in
#                          sources.json
#
# Rebuild with: python build_registry.py
registry/*.entries.jsonl.gz
registry/*.manifest.json
