# Python
__pycache__/
*.py[cod]
.pytest_cache/

# Generated registry.
#
# Only registry/sources.json is source: it is hand-written and pins every
# upstream source by tag and sha256. The registry database is build output
# produced by `python build_registry.py` -- a binary SQLite file, rewritten on
# every build and not meant to be diffed or committed. Rebuild with:
#   python build_registry.py
registry/registry.db

# Legacy file-based registry output (superseded by registry.db).
registry/*.entries.jsonl.gz
registry/*.manifest.json
